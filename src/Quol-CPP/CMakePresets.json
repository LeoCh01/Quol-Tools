{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "qt-mingw-plugins-release",
      "displayName": "Qt MinGW Plugins Release",
      "description": "Needs CMakeUserPresets.json (Qt/MinGW paths + QUOL_HOST_ROOT) and a release host build.",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/plugins-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "qt-mingw-plugins-release",
      "configurePreset": "qt-mingw-plugins-release",
      "jobs": 0
    }
  ]
}
